<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp" android:layout_width="match_parent" android:layout_height="72dp">

    <ImageView
        android:id="@+id/icon" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_alignParentStart="true" android:contentDescription="@null"/>

    <TextView
        android:id="@+id/title" android:textSize="16sp" android:textStyle="bold"
        android:layout_toEndOf="@id/icon" android:layout_marginStart="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/sub" android:textSize="12sp"
        android:layout_below="@id/title" android:layout_toEndOf="@id/icon"
        android:layout_marginStart="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</RelativeLayout>
